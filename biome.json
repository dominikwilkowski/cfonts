{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": ["biome.json", "npm/**/*.js", "npm/**/*.ts", "package.json", "tsconfig.json"]
	},
	"overrides": [
		{
			"includes": ["tsconfig.json"],
			"json": {
				"formatter": {
					"trailingCommas": "all"
				}
			}
		}
	],
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineEnding": "lf",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
