{
	"name": "cfonts",
	"description": "Sexy ANSI fonts for the console",
	"version": "4.0.0",
	"type": "module",
	"homepage": "https://github.com/dominikwilkowski/cfonts",
	"author": {
		"name": "Dominik Wilkowski",
		"email": "Hi@Dominik-Wilkowski.com",
		"url": "http://dominik-wilkowski.com/"
	},
	"contributors": [
		{
			"name": "Dominik Wilkowski",
			"email": "Hi@Dominik-Wilkowski.com",
			"url": "http://dominik-wilkowski.com/"
		}
	],
	"repository": {
		"type": "git",
		"url": "git://github.com/dominikwilkowski/cfonts.git"
	},
	"bugs": {
		"url": "https://github.com/dominikwilkowski/cfonts/issues"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"clean": "rm -rf dist pkg",
		"build:wasm": "wasm-pack build crates/wasm --release --target web --out-dir ../../pkg && rm -f pkg/.gitignore pkg/README.md pkg/LICENSE pkg/package.json && node npm/patch_types.js",
		"build:ts": "tsc -p tsconfig.json",
		"build": "pnpm run clean && pnpm run build:wasm && pnpm run build:ts",
		"format": "biome format --write .",
		"test:biome": "biome check --error-on-warnings .",
		"test:types": "tsc -p npm/tests/types/tsconfig.node.json && tsc -p npm/tests/types/tsconfig.browser.json",
		"test:rust": "cargo test --locked --workspace --all-targets --all-features && cargo test --locked --doc --workspace --all-features",
		"test:wasm": "wasm-pack test --node crates/wasm",
		"test:js": "node --test npm/tests/npm.node.test.js",
		"test:bundle": "vite build crates/cfonts/examples/browser --outDir ../../../../target/browser-example --emptyOutDir",
		"test:boundary": "node --test npm/tests/npm.browser-boundary.test.js",
		"test:browser": "pnpm run test:bundle && pnpm run test:boundary && playwright test",
		"test:package": "pnpm run build && pnpm run test:package:built",
		"test:package:built": "pnpm run test:types && pnpm run test:js && pnpm run test:browser",
		"test:frameworks": "cargo check --locked --manifest-path crates/cfonts/examples/leptos/Cargo.toml --target wasm32-unknown-unknown && cargo check --locked --manifest-path crates/cfonts/examples/dioxus/Cargo.toml --target wasm32-unknown-unknown",
		"test": "pnpm run test:biome && pnpm run test:rust && pnpm run test:frameworks && pnpm run test:wasm && pnpm run test:package",
		"example:node": "pnpm run build && node crates/cfonts/examples/node.js",
		"example:browser": "pnpm run build && vite crates/cfonts/examples/browser",
		"example:leptos": "cd crates/cfonts/examples/leptos && trunk serve",
		"example:dioxus": "cd crates/cfonts/examples/dioxus && trunk serve",
		"prepublishOnly": "pnpm run test"
	},
	"dependencies": {
		"window-size": "^1"
	},
	"devDependencies": {
		"@biomejs/biome": "2",
		"@playwright/test": "^1",
		"@types/node": "^20",
		"typescript": "^7",
		"vite": "8",
		"wasm-pack": "^0.15"
	},
	"keywords": [
		"font",
		"banner",
		"logo",
		"CLI",
		"console",
		"ascii",
		"pretty"
	],
	"files": [
		"dist/**/*",
		"pkg/cfonts_wasm.js",
		"pkg/cfonts_wasm.d.ts",
		"pkg/cfonts_wasm_bg.wasm",
		"README.md",
		"LICENSE"
	],
	"types": "./dist/browser.d.ts",
	"exports": {
		".": {
			"browser": {
				"types": "./dist/browser.d.ts",
				"default": "./dist/browser.js"
			},
			"node": {
				"types": "./dist/node.d.ts",
				"default": "./dist/node.js"
			},
			"types": "./dist/browser.d.ts",
			"default": "./dist/browser.js"
		}
	},
	"licenses": [
		{
			"type": "GPL-3.0-or-later",
			"url": "https://github.com/dominikwilkowski/cfonts/blob/released/LICENSE"
		}
	],
	"license": "GPL-3.0-or-later"
}
